---
import '../../styles/global.css';
---
<!DOCTYPE html>
<html lang="en" class="antialiased">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Promotion Page | ToolMate UI</title>
</head>
<body class="bg-background text-foreground min-h-screen">
  <header class="border-b border-border bg-background/95 backdrop-blur sticky top-0 z-50">
  <div class="container mx-auto flex h-16 items-center justify-between px-4">
    <a href="#" class="font-bold text-xl flex items-center gap-2">
      <div class="h-8 w-8 rounded bg-primary text-primary-foreground flex items-center justify-center font-bold">T</div>
      ToolMate
    </a>
    <nav class="hidden md:flex space-x-6 text-sm font-medium">
      <a href="#" class="text-foreground hover:text-primary">Features</a>
      <a href="#" class="text-muted-foreground hover:text-foreground">Pricing</a>
      <a href="#" class="text-muted-foreground hover:text-foreground">About</a>
      <a href="#" class="text-muted-foreground hover:text-foreground">Blog</a>
    </nav>
    <div class="flex items-center space-x-4">
      <button class="text-sm font-medium hover:text-primary">Sign In</button>
      <button class="bg-primary text-primary-foreground h-9 px-4 rounded-md text-sm font-medium hidden md:block">Get Started</button>
      <button class="md:hidden">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>
    </div>
  </div>
</header>
    <main>
      <section class="py-20 bg-red-600 text-white text-center">
        <div class="container mx-auto px-4">
          <h1 class="text-5xl md:text-7xl font-extrabold uppercase tracking-widest mb-6">Black Friday Sale</h1>
          <p class="text-2xl font-light mb-8">Up to 80% off on all premium templates.</p>
          <div class="flex justify-center gap-4 mb-10 font-mono text-3xl font-bold">
            <div class="bg-black/20 p-4 rounded-lg"><div>02</div><div class="text-xs font-sans font-normal uppercase">Days</div></div>
            <div class="text-4xl py-4">:</div>
            <div class="bg-black/20 p-4 rounded-lg"><div>14</div><div class="text-xs font-sans font-normal uppercase">Hours</div></div>
            <div class="text-4xl py-4">:</div>
            <div class="bg-black/20 p-4 rounded-lg"><div>59</div><div class="text-xs font-sans font-normal uppercase">Mins</div></div>
          </div>
          <button class="bg-white text-red-600 text-xl font-bold py-4 px-12 rounded-full hover:scale-105 transition-transform shadow-xl">Shop Now</button>
        </div>
      </section>
      <section class="py-24 bg-muted/30">
        <div class="container mx-auto px-4">
          <h2 class="text-3xl font-bold text-center mb-12">Doorbuster Deals</h2>
          <div class="grid md:grid-cols-4 gap-6">
            <div class="bg-background rounded-xl p-6 border shadow-sm text-center relative overflow-hidden">
              <div class="absolute top-4 right-[-30px] bg-red-600 text-white font-bold text-xs px-10 py-1 rotate-45">SAVE $50</div>
              <div class="h-40 bg-muted rounded-md mb-4 flex items-center justify-center"><img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=400&q=80" class="w-full h-full object-cover rounded-md" /></div>
              <h3 class="font-semibold text-lg">Pro Dashboard UI</h3>
              <div class="mt-2 text-xl font-bold text-red-600">$19 <span class="line-through text-sm text-muted-foreground">$69</span></div>
              <button class="w-full mt-4 bg-primary text-primary-foreground py-2 rounded">Add to Cart</button>
            </div>
            <div class="bg-background rounded-xl p-6 border shadow-sm text-center relative overflow-hidden">
              <div class="absolute top-4 right-[-30px] bg-red-600 text-white font-bold text-xs px-10 py-1 rotate-45">SAVE $20</div>
              <div class="h-40 bg-muted rounded-md mb-4 flex items-center justify-center"><img src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=400&q=80" class="w-full h-full object-cover rounded-md" /></div>
              <h3 class="font-semibold text-lg">Landing Page Kit</h3>
              <div class="mt-2 text-xl font-bold text-red-600">$9 <span class="line-through text-sm text-muted-foreground">$29</span></div>
              <button class="w-full mt-4 bg-primary text-primary-foreground py-2 rounded">Add to Cart</button>
            </div>
          </div>
        </div>
      </section>
    </main>
    <footer class="border-t border-border bg-muted/20 py-12">
  <div class="container mx-auto px-4 grid grid-cols-2 md:grid-cols-4 gap-8">
    <div class="col-span-2">
      <a href="#" class="font-bold text-xl flex items-center gap-2 mb-4">
        <div class="h-6 w-6 rounded bg-primary text-primary-foreground flex items-center justify-center font-bold text-xs">T</div>
        ToolMate
      </a>
      <p class="text-muted-foreground max-w-xs text-sm">Building the web faster with beautiful templates and components.</p>
    </div>
    <div>
      <h3 class="font-semibold mb-3">Links</h3>
      <ul class="space-y-2 text-sm text-muted-foreground">
        <li><a href="#" class="hover:text-primary">Home</a></li>
        <li><a href="#" class="hover:text-primary">Pricing</a></li>
        <li><a href="#" class="hover:text-primary">About</a></li>
      </ul>
    </div>
    <div>
      <h3 class="font-semibold mb-3">Legal</h3>
      <ul class="space-y-2 text-sm text-muted-foreground">
        <li><a href="#" class="hover:text-primary">Privacy</a></li>
        <li><a href="#" class="hover:text-primary">Terms</a></li>
      </ul>
    </div>
  </div>
  <div class="container mx-auto px-4 mt-12 pt-8 border-t border-border text-sm text-muted-foreground text-center">
    © 2026 ToolMate UI. All rights reserved.
  </div>
</footer>
</body>
</html>