---
import '../../styles/global.css';
---
<!DOCTYPE html>
<html lang="en" class="antialiased">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Project Landing | ToolMate UI</title>
</head>
<body class="bg-background text-foreground min-h-screen">
  <div class="dark bg-[#0a0a0a] text-white min-h-screen">
      <header class="border-b border-white/10 bg-[#0a0a0a]/95 backdrop-blur sticky top-0 z-50">
  <div class="container mx-auto flex h-16 items-center justify-between px-4">
    <a href="#" class="font-bold text-xl flex items-center gap-2">
      <div class="h-8 w-8 rounded bg-primary text-primary-foreground flex items-center justify-center font-bold">T</div>
      ToolMate
    </a>
    <nav class="hidden md:flex space-x-6 text-sm font-medium">
      <a href="#" class="text-white hover:text-primary">Features</a>
      <a href="#" class="text-muted-foreground hover:text-white">Pricing</a>
      <a href="#" class="text-muted-foreground hover:text-white">About</a>
      <a href="#" class="text-muted-foreground hover:text-white">Blog</a>
    </nav>
    <div class="flex items-center space-x-4">
      <button class="text-sm font-medium hover:text-primary">Sign In</button>
      <button class="bg-primary text-primary-foreground h-9 px-4 rounded-md text-sm font-medium hidden md:block">Get Started</button>
      <button class="md:hidden">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>
    </div>
  </div>
</header>
      <main>
        <section class="py-32 relative overflow-hidden">
          <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')]"></div>
          <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-blue-500/20 rounded-full blur-[120px] pointer-events-none"></div>
          
          <div class="container mx-auto px-4 text-center relative z-10">
            <div class="inline-flex items-center border border-white/10 rounded-full px-4 py-1.5 text-sm mb-8 bg-white/5 backdrop-blur">
              <span class="w-2 h-2 rounded-full bg-blue-500 mr-2 animate-pulse"></span> GPT-5 Powered Model Available
            </div>
            <h1 class="text-6xl md:text-8xl font-black tracking-tighter mb-8 bg-clip-text text-transparent bg-gradient-to-b from-white to-white/50">
              Intelligence,<br/>Amplified.
            </h1>
            <p class="text-xl text-white/60 max-w-2xl mx-auto mb-10">Deploy autonomous agents that reason, plan, and execute complex workflows directly within your infrastructure.</p>
            <div class="flex flex-col sm:flex-row justify-center gap-4">
              <button class="bg-white text-black h-12 px-8 rounded-lg font-medium hover:bg-white/90">Start Free Trial</button>
              <button class="border border-white/20 h-12 px-8 rounded-lg font-medium hover:bg-white/5">Read the Paper</button>
            </div>
          </div>
        </section>

        <section class="py-24 border-y border-white/10 bg-white/[0.02]">
          <div class="container mx-auto px-4">
            <div class="rounded-xl border border-white/10 bg-black/50 backdrop-blur overflow-hidden shadow-2xl">
              <div class="border-b border-white/10 px-4 py-3 flex gap-2">
                <div class="w-3 h-3 rounded-full bg-red-500/50"></div>
                <div class="w-3 h-3 rounded-full bg-yellow-500/50"></div>
                <div class="w-3 h-3 rounded-full bg-green-500/50"></div>
              </div>
              <div class="p-6 font-mono text-sm text-green-400">
                <p>$ agent-cli start --mode autonomous</p>
                <p class="text-white/50 mt-2">> Initializing neural pathways...</p>
                <p class="text-white/50">> Connecting to vast knowledge bases...</p>
                <p class="text-blue-400 mt-2">> Agent Ready. Awaiting prompt.</p>
                <p class="mt-4">Build me a full-stack React application with authentication.</p>
                <p class="text-white/50 mt-2">> Planning architecture...</p>
                <p class="text-white/50">> Writing code...</p>
                <p class="text-yellow-400 mt-2">✨ Deployment complete in 4.2 seconds.</p>
              </div>
            </div>
          </div>
        </section>
      </main>
      <footer class="border-t border-white/10 bg-black py-12">
  <div class="container mx-auto px-4 grid grid-cols-2 md:grid-cols-4 gap-8">
    <div class="col-span-2">
      <a href="#" class="font-bold text-xl flex items-center gap-2 mb-4">
        <div class="h-6 w-6 rounded bg-primary text-primary-foreground flex items-center justify-center font-bold text-xs">T</div>
        ToolMate
      </a>
      <p class="text-white/60 max-w-xs text-sm">Building the web faster with beautiful templates and components.</p>
    </div>
    <div>
      <h3 class="font-semibold mb-3">Links</h3>
      <ul class="space-y-2 text-sm text-white/60">
        <li><a href="#" class="hover:text-primary">Home</a></li>
        <li><a href="#" class="hover:text-primary">Pricing</a></li>
        <li><a href="#" class="hover:text-primary">About</a></li>
      </ul>
    </div>
    <div>
      <h3 class="font-semibold mb-3">Legal</h3>
      <ul class="space-y-2 text-sm text-white/60">
        <li><a href="#" class="hover:text-primary">Privacy</a></li>
        <li><a href="#" class="hover:text-primary">Terms</a></li>
      </ul>
    </div>
  </div>
  <div class="container mx-auto px-4 mt-12 pt-8 border-t border-border text-sm text-white/60 text-center">
    © 2026 ToolMate UI. All rights reserved.
  </div>
</footer>
    </div>
</body>
</html>