---
import '../../styles/global.css';
---
<!DOCTYPE html>
<html lang="en" class="antialiased">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mobile App Launch | ToolMate UI</title>
</head>
<body class="bg-background text-foreground min-h-screen">
  <header class="border-b border-border bg-background/95 backdrop-blur sticky top-0 z-50">
  <div class="container mx-auto flex h-16 items-center justify-between px-4">
    <a href="#" class="font-bold text-xl flex items-center gap-2">
      <div class="h-8 w-8 rounded bg-primary text-primary-foreground flex items-center justify-center font-bold">T</div>
      ToolMate
    </a>
    <nav class="hidden md:flex space-x-6 text-sm font-medium">
      <a href="#" class="text-foreground hover:text-primary">Features</a>
      <a href="#" class="text-muted-foreground hover:text-foreground">Pricing</a>
      <a href="#" class="text-muted-foreground hover:text-foreground">About</a>
      <a href="#" class="text-muted-foreground hover:text-foreground">Blog</a>
    </nav>
    <div class="flex items-center space-x-4">
      <button class="text-sm font-medium hover:text-primary">Sign In</button>
      <button class="bg-primary text-primary-foreground h-9 px-4 rounded-md text-sm font-medium hidden md:block">Get Started</button>
      <button class="md:hidden">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>
    </div>
  </div>
</header>
    <main>
      <section class="py-24 bg-gradient-to-b from-primary/10 to-background overflow-hidden relative">
        <div class="container mx-auto px-4 flex flex-col lg:flex-row items-center gap-12">
          <div class="lg:w-1/2 text-center lg:text-left z-10">
            <span class="px-3 py-1 text-xs font-semibold bg-primary/10 text-primary rounded-full mb-4 inline-block">New Release v2.0</span>
            <h1 class="text-5xl lg:text-7xl font-bold tracking-tight mb-6">Your Life, Organized.</h1>
            <p class="text-xl text-muted-foreground mb-8 max-w-xl mx-auto lg:mx-0">The most intuitive habit tracker and daily planner. Join 1M+ users transforming their routines today.</p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
              <a href="#" class="flex items-center justify-center gap-2 bg-black text-white h-14 px-6 rounded-xl hover:bg-black/90 transition-transform hover:scale-105">
                <svg viewBox="0 0 384 512" class="w-6 h-6 fill-current"><path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/></svg>
                <div class="text-left">
                  <div class="text-[10px] leading-tight">Download on the</div>
                  <div class="text-base font-semibold leading-tight">App Store</div>
                </div>
              </a>
              <a href="#" class="flex items-center justify-center gap-2 bg-black text-white h-14 px-6 rounded-xl hover:bg-black/90 transition-transform hover:scale-105">
                <svg viewBox="0 0 512 512" class="w-6 h-6 fill-current"><path d="M325.3 234.3L104.6 13l280.8 161.2-60.1 60.1zM47 0C34 6.8 25.3 19.2 25.3 35.3v441.3c0 16.1 8.7 28.5 21.7 35.3l256.6-256L47 0zm425.2 225.6l-58.9-34.1-65.7 64.5 65.7 64.5 60.1-34.1c18-14.3 18-46.5-1.2-60.8zM104.6 499l280.8-161.2-60.1-60.1L104.6 499z"/></svg>
                <div class="text-left">
                  <div class="text-[10px] leading-tight">GET IT ON</div>
                  <div class="text-base font-semibold leading-tight">Google Play</div>
                </div>
              </a>
            </div>
            <div class="mt-8 flex items-center justify-center lg:justify-start gap-4 text-sm text-muted-foreground">
              <div class="flex -space-x-2">
                <img class="w-8 h-8 rounded-full border-2 border-background" src="https://i.pravatar.cc/100?u=1" />
                <img class="w-8 h-8 rounded-full border-2 border-background" src="https://i.pravatar.cc/100?u=2" />
                <img class="w-8 h-8 rounded-full border-2 border-background" src="https://i.pravatar.cc/100?u=3" />
                <img class="w-8 h-8 rounded-full border-2 border-background" src="https://i.pravatar.cc/100?u=4" />
              </div>
              <p>Loved by 1M+ users</p>
            </div>
          </div>
          <div class="lg:w-1/2 relative flex justify-center">
            <div class="absolute inset-0 bg-primary/20 blur-3xl rounded-full scale-150 transform translate-y-12 z-0"></div>
            <div class="relative z-10 w-[280px] h-[580px] bg-black rounded-[40px] border-[8px] border-black overflow-hidden shadow-2xl">
              <img src="https://images.unsplash.com/photo-1616348436168-de43ad0db179?w=400&h=800&fit=crop" class="w-full h-full object-cover" />
            </div>
          </div>
        </div>
      </section>

      <section class="py-24 bg-background">
        <div class="container mx-auto px-4 text-center">
          <h2 class="text-3xl font-bold mb-12">Features designed for focus</h2>
          <div class="grid md:grid-cols-3 gap-8">
            <div class="p-6 border border-border rounded-2xl bg-card hover:shadow-lg transition-all">
              <div class="w-12 h-12 bg-primary/10 text-primary rounded-xl flex items-center justify-center mb-4 mx-auto">
                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 20v-6M6 20V10M18 20V4"/></svg>
              </div>
              <h3 class="text-xl font-semibold mb-2">Detailed Analytics</h3>
              <p class="text-muted-foreground">Track your progress over time with beautiful charts and insights.</p>
            </div>
            <div class="p-6 border border-border rounded-2xl bg-card hover:shadow-lg transition-all">
              <div class="w-12 h-12 bg-primary/10 text-primary rounded-xl flex items-center justify-center mb-4 mx-auto">
                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </div>
              <h3 class="text-xl font-semibold mb-2">Smart Reminders</h3>
              <p class="text-muted-foreground">Never miss a habit with location and time-based notifications.</p>
            </div>
            <div class="p-6 border border-border rounded-2xl bg-card hover:shadow-lg transition-all">
              <div class="w-12 h-12 bg-primary/10 text-primary rounded-xl flex items-center justify-center mb-4 mx-auto">
                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              </div>
              <h3 class="text-xl font-semibold mb-2">Secure & Private</h3>
              <p class="text-muted-foreground">Your data is encrypted and synced securely across all your devices.</p>
            </div>
          </div>
        </div>
      </section>
    </main>
    <footer class="border-t border-border bg-muted/20 py-12">
  <div class="container mx-auto px-4 grid grid-cols-2 md:grid-cols-4 gap-8">
    <div class="col-span-2">
      <a href="#" class="font-bold text-xl flex items-center gap-2 mb-4">
        <div class="h-6 w-6 rounded bg-primary text-primary-foreground flex items-center justify-center font-bold text-xs">T</div>
        ToolMate
      </a>
      <p class="text-muted-foreground max-w-xs text-sm">Building the web faster with beautiful templates and components.</p>
    </div>
    <div>
      <h3 class="font-semibold mb-3">Links</h3>
      <ul class="space-y-2 text-sm text-muted-foreground">
        <li><a href="#" class="hover:text-primary">Home</a></li>
        <li><a href="#" class="hover:text-primary">Pricing</a></li>
        <li><a href="#" class="hover:text-primary">About</a></li>
      </ul>
    </div>
    <div>
      <h3 class="font-semibold mb-3">Legal</h3>
      <ul class="space-y-2 text-sm text-muted-foreground">
        <li><a href="#" class="hover:text-primary">Privacy</a></li>
        <li><a href="#" class="hover:text-primary">Terms</a></li>
      </ul>
    </div>
  </div>
  <div class="container mx-auto px-4 mt-12 pt-8 border-t border-border text-sm text-muted-foreground text-center">
    © 2026 ToolMate UI. All rights reserved.
  </div>
</footer>
</body>
</html>