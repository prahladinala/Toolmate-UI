---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 - Page Not Found">
  <div class="flex flex-col items-center justify-center min-h-[80vh] text-center px-4">
    <div class="space-y-4">
      <h1 class="text-8xl font-extrabold tracking-tighter text-primary">404</h1>
      <h2 class="text-3xl font-bold tracking-tight">Page not found</h2>
      <p class="text-muted-foreground max-w-[500px] mx-auto">
        Sorry, we couldn't find the page you're looking for. It might have been moved or deleted.
      </p>
      <div class="pt-6">
        <a href="/" class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-8 text-sm font-medium text-primary-foreground shadow transition-colors hover:bg-primary/90">
          Go back home
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
