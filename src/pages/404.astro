---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  Compass,
  Home,
  Boxes,
  Layout,
  BookOpen,
  ArrowRight
} from 'lucide-astro';

const quickLinks = [
  {
    title: 'UI Components',
    desc: '15+ accessible primitives and controls',
    href: '/components',
    icon: Boxes
  },
  {
    title: 'Page Sections',
    desc: '12+ full sections with 100+ variations',
    href: '/sections',
    icon: Layout
  },
  {
    title: 'Website Templates',
    desc: '12+ complete landing pages & templates',
    href: '/templates',
    icon: Compass
  },
  {
    title: 'Documentation',
    desc: 'Framework setup guides & tutorials',
    href: '/docs/installation',
    icon: BookOpen
  }
];
---

<BaseLayout title="404 - Page Not Found | ToolMate UI" description="The page you are looking for could not be found. Explore our components, sections, and templates.">
  <main class="flex-1 flex flex-col items-center justify-center py-16 md:py-24 relative overflow-hidden">
    <!-- Atmospheric Ambient Glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[300px] bg-primary/10 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="container mx-auto px-4 max-w-2xl text-center relative z-10 space-y-8">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-border/80 bg-muted/60 text-xs font-semibold text-muted-foreground shadow-2xs">
        <span class="inline-block h-2 w-2 rounded-full bg-amber-500 animate-pulse"></span>
        <span>Error 404 • Lost In Space</span>
      </div>

      <!-- Hero 404 Graphic Heading -->
      <div class="space-y-2">
        <h1 class="text-7xl sm:text-8xl md:text-9xl font-black tracking-tighter bg-gradient-to-b from-foreground via-foreground/80 to-foreground/20 bg-clip-text text-transparent select-none">
          404
        </h1>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground">
          Page Not Found
        </h2>
        <p class="text-base text-muted-foreground max-w-md mx-auto leading-relaxed">
          The page or component you are looking for might have been relocated, renamed, or temporarily misplaced.
        </p>
      </div>

      <!-- Action Button -->
      <div class="pt-2 flex justify-center">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-primary text-primary-foreground font-semibold text-sm hover:bg-primary/90 shadow-xs transition-all hover:gap-3"
        >
          <Home class="h-4 w-4" />
          <span>Return Home</span>
        </a>
      </div>

      <!-- Quick Helpful Navigation Matrix -->
      <div class="pt-8 border-t border-border/60">
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground/80 mb-4">
          Or explore popular directories:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-left">
          {quickLinks.map(link => {
            const Icon = link.icon;
            return (
              <a
                href={link.href}
                class="group flex items-center justify-between p-3.5 rounded-xl border border-border/70 bg-card/60 hover:bg-muted/60 hover:border-primary/40 transition-all"
              >
                <div class="flex items-center gap-3">
                  <div class="h-8 w-8 rounded-lg bg-primary/10 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-primary-foreground transition-colors">
                    <Icon class="h-4 w-4" />
                  </div>
                  <div>
                    <h3 class="text-xs font-semibold text-foreground group-hover:text-primary transition-colors">
                      {link.title}
                    </h3>
                    <p class="text-[11px] text-muted-foreground line-clamp-1">
                      {link.desc}
                    </p>
                  </div>
                </div>
                <ArrowRight class="h-3.5 w-3.5 text-muted-foreground/40 group-hover:text-primary group-hover:translate-x-0.5 transition-all" />
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
