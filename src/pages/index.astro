---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  Sparkles,
  ArrowRight,
  ChevronDown,
  Layers,
  Code2,
  Zap,
  CheckCircle2,
  ExternalLink
} from 'lucide-astro';

const faqs = [
  {
    question: "Is ToolMate UI completely free?",
    answer: "Yes, ToolMate UI is 100% free and open-source under the MIT license. You can use every component, section, and template in personal, freelance, and commercial projects without any fees, paywalls, or attribution requirements."
  },
  {
    question: "Do I need to install an npm package or create an account?",
    answer: "No account and no npm packages required. ToolMate UI follows a pure copy-and-paste philosophy—you copy the code directly into your codebase and own every line. No third-party lock-in and zero dependency conflicts."
  },
  {
    question: "Which frontend frameworks are supported?",
    answer: "Every component is supplied with ready-to-copy code for React, Next.js, Astro, Vue.js, Svelte, and plain HTML. All styles utilize pure Tailwind CSS utility classes."
  },
  {
    question: "Does it support both Tailwind CSS v4 and v3?",
    answer: "Yes. ToolMate UI is engineered with modern Tailwind CSS principles and standard CSS variables for theme tokens, making it fully compatible with both Tailwind v3 and v4."
  },
  {
    question: "Where is my data stored?",
    answer: "ToolMate UI is completely client-side and open-access. We do not store, track, or collect your code or data. Everything runs securely on your machine."
  }
];
---

<BaseLayout
  title="ToolMate UI - Production-Ready Tailwind CSS Components & Templates"
  description="Free, open-source Tailwind CSS UI component and template library. Copy-and-paste accessible components for React, Next.js, Astro, Vue, Svelte, and HTML."
>
  <main class="flex-1">
    <!-- Hero Section -->
    <section class="space-y-6 pb-12 pt-16 md:pb-16 md:pt-24 lg:py-28 overflow-hidden relative">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-primary/10 rounded-full blur-[140px] pointer-events-none"></div>

      <div class="container mx-auto max-w-screen-xl flex flex-col items-center gap-6 text-center px-4 relative z-10">
        <a href="/docs" class="inline-flex items-center gap-2 rounded-full border border-border/80 bg-muted/60 px-3.5 py-1 text-xs font-semibold text-muted-foreground shadow-2xs hover:border-primary/40 transition-all">
          <span class="flex h-2 w-2 rounded-full bg-primary animate-pulse"></span>
          <span>Introducing ToolMate UI v2.0 • 100% Free & Open Source</span>
        </a>

        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black tracking-tight max-w-4xl text-foreground">
          Production-Ready Tailwind <br class="hidden sm:inline" />
          <span class="bg-gradient-to-r from-foreground via-foreground/90 to-foreground/60 bg-clip-text text-transparent">
            Components & Templates
          </span>
        </h1>

        <p class="max-w-[44rem] text-muted-foreground text-base sm:text-lg leading-relaxed">
          Copy, customize, and ship accessible interfaces in minutes. Zero npm runtime bloat. Zero setup overhead. Just beautiful, modern Tailwind CSS.
        </p>

        <div class="flex flex-col sm:flex-row gap-3 pt-2">
          <a
            href="/components"
            class="inline-flex h-11 items-center justify-center rounded-xl bg-primary px-7 text-sm font-semibold text-primary-foreground shadow-xs hover:bg-primary/90 transition-all gap-2"
          >
            <span>Browse Components</span>
            <ArrowRight class="h-4 w-4" />
          </a>
          <a
            href="/templates"
            class="inline-flex h-11 items-center justify-center rounded-xl border border-border bg-card/60 hover:bg-muted px-7 text-sm font-semibold text-foreground shadow-2xs transition-all"
          >
            Explore Templates
          </a>
        </div>
      </div>
    </section>

    <!-- Stats Grid -->
    <section class="container mx-auto max-w-screen-xl py-10 px-4 border-t border-border/40">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 text-center">
        <div class="flex flex-col items-center justify-center space-y-1.5 p-6 rounded-2xl bg-card/40 border border-border/60 hover:border-primary/30 transition-colors">
          <h3 class="text-3xl sm:text-4xl font-extrabold text-foreground stat-counter" data-target="200">200+</h3>
          <p class="text-xs sm:text-sm text-muted-foreground font-medium">UI Components</p>
        </div>
        <div class="flex flex-col items-center justify-center space-y-1.5 p-6 rounded-2xl bg-card/40 border border-border/60 hover:border-primary/30 transition-colors">
          <h3 class="text-3xl sm:text-4xl font-extrabold text-foreground stat-counter" data-target="100">100+</h3>
          <p class="text-xs sm:text-sm text-muted-foreground font-medium">Section Variations</p>
        </div>
        <div class="flex flex-col items-center justify-center space-y-1.5 p-6 rounded-2xl bg-card/40 border border-border/60 hover:border-primary/30 transition-colors">
          <h3 class="text-3xl sm:text-4xl font-extrabold text-foreground stat-counter" data-target="12">12+</h3>
          <p class="text-xs sm:text-sm text-muted-foreground font-medium">Full Templates</p>
        </div>
        <div class="flex flex-col items-center justify-center space-y-1.5 p-6 rounded-2xl bg-card/40 border border-border/60 hover:border-primary/30 transition-colors">
          <h3 class="text-3xl sm:text-4xl font-extrabold text-foreground stat-counter" data-target="6">6</h3>
          <p class="text-xs sm:text-sm text-muted-foreground font-medium">Frameworks Supported</p>
        </div>
      </div>
    </section>

    <!-- SECTION 1: SIMPLE WORKFLOW (From Reference Image) -->
    <section class="py-16 md:py-24 border-t border-border/40">
      <div class="container mx-auto max-w-screen-xl px-4">
        <!-- Section Header -->
        <div class="text-center space-y-3 mb-14">
          <span class="text-purple-400 font-semibold text-xs tracking-widest uppercase block">
            SIMPLE WORKFLOW
          </span>
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-foreground">
            From Blank Canvas to Production in 3 Steps
          </h2>
          <p class="text-sm sm:text-base text-muted-foreground max-w-lg mx-auto leading-relaxed">
            Quick, intuitive, and frictionless developer workflow.
          </p>
        </div>

        <!-- 3 Step Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
          <!-- Step 01 -->
          <div class="group rounded-2xl border border-border/80 bg-card/40 dark:bg-zinc-950/60 p-8 text-center flex flex-col items-center justify-between hover:border-zinc-700 transition-all hover:-translate-y-1 hover:shadow-lg">
            <div class="h-11 w-11 rounded-full border border-border/80 bg-muted/60 dark:bg-zinc-900 flex items-center justify-center font-mono text-xs font-bold text-foreground mb-6 shadow-inner">
              01
            </div>
            <div class="space-y-3 flex-1 flex flex-col justify-center">
              <h3 class="text-lg font-bold text-foreground">Choose a Component</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">
                Select from 200+ accessible primitives, responsive section layouts, or complete website templates engineered for clean HTML.
              </p>
            </div>
            <a href="/components" class="text-purple-400 hover:text-purple-300 text-xs font-semibold inline-flex items-center gap-1 mt-6 transition-colors group-hover:gap-1.5">
              <span>Browse Catalog</span>
              <ArrowRight class="h-3 w-3" />
            </a>
          </div>

          <!-- Step 02 -->
          <div class="group rounded-2xl border border-border/80 bg-card/40 dark:bg-zinc-950/60 p-8 text-center flex flex-col items-center justify-between hover:border-zinc-700 transition-all hover:-translate-y-1 hover:shadow-lg">
            <div class="h-11 w-11 rounded-full border border-border/80 bg-muted/60 dark:bg-zinc-900 flex items-center justify-center font-mono text-xs font-bold text-foreground mb-6 shadow-inner">
              02
            </div>
            <div class="space-y-3 flex-1 flex flex-col justify-center">
              <h3 class="text-lg font-bold text-foreground">Copy Code or Import</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">
                Grab copy-ready code for React, Next.js, Astro, Vue, Svelte, or plain HTML with one click. Zero npm bloat, full code ownership.
              </p>
            </div>
            <a href="/docs" class="text-purple-400 hover:text-purple-300 text-xs font-semibold inline-flex items-center gap-1 mt-6 transition-colors group-hover:gap-1.5">
              <span>Setup Guides</span>
              <ArrowRight class="h-3 w-3" />
            </a>
          </div>

          <!-- Step 03 -->
          <div class="group rounded-2xl border border-border/80 bg-card/40 dark:bg-zinc-950/60 p-8 text-center flex flex-col items-center justify-between hover:border-zinc-700 transition-all hover:-translate-y-1 hover:shadow-lg">
            <div class="h-11 w-11 rounded-full border border-border/80 bg-muted/60 dark:bg-zinc-900 flex items-center justify-center font-mono text-xs font-bold text-foreground mb-6 shadow-inner">
              03
            </div>
            <div class="space-y-3 flex-1 flex flex-col justify-center">
              <h3 class="text-lg font-bold text-foreground">Ship & Customize</h3>
              <p class="text-xs text-muted-foreground leading-relaxed">
                Paste directly into your project. Tweak Tailwind utilities or CSS variable tokens and deploy pixel-perfect UIs with ease.
              </p>
            </div>
            <a href="/templates" class="text-purple-400 hover:text-purple-300 text-xs font-semibold inline-flex items-center gap-1 mt-6 transition-colors group-hover:gap-1.5">
              <span>Export & Deploy</span>
              <ArrowRight class="h-3 w-3" />
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: BUILT BY CREATOR CARD (From Reference Image) -->
    <section class="py-12 md:py-16 border-t border-border/40">
      <div class="container mx-auto max-w-screen-xl px-4">
        <div class="max-w-3xl mx-auto rounded-2xl border border-border/80 bg-card/40 dark:bg-zinc-950/60 p-6 sm:p-10 shadow-sm hover:border-zinc-700 transition-all">
          <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 md:gap-8">
            <!-- Creator Info -->
            <div class="space-y-4 max-w-md">
              <div class="flex items-center gap-3.5">
                <img
                  src="https://github.com/prahladinala.png"
                  alt="Prahlad Inala"
                  class="h-12 w-12 rounded-full border border-border/80 object-cover shadow-xs"
                  loading="lazy"
                />
                <div>
                  <span class="text-purple-400 font-semibold text-[11px] tracking-wider uppercase block">
                    BUILT BY
                  </span>
                  <h3 class="text-lg font-bold text-foreground">
                    Prahlad Inala
                  </h3>
                  <p class="text-xs text-muted-foreground">
                    Software Engineer & Open-Source Creator
                  </p>
                </div>
              </div>
              <p class="text-xs text-muted-foreground leading-relaxed">
                Built ToolMate UI to eliminate paywalled UI kits, bloated dependencies, and broken styling. Dedicated to giving every developer clean, copy-and-paste, accessible building blocks.
              </p>
            </div>

            <!-- Connect Links -->
            <div class="md:border-l md:border-border/60 md:pl-8 space-y-2.5 shrink-0 w-full md:w-auto pt-4 md:pt-0 border-t md:border-t-0 border-border/40">
              <span class="text-[10px] font-bold tracking-widest text-muted-foreground uppercase block mb-3">
                CONNECT
              </span>
              <div>
                <a
                  href="https://github.com/prahladinala"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs font-semibold text-foreground hover:text-purple-400 inline-flex items-center gap-1.5 transition-colors"
                >
                  <span>GitHub Profile</span>
                  <span>→</span>
                </a>
              </div>
              <div>
                <a
                  href="https://linkedin.com/in/prahladinala"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs font-semibold text-foreground hover:text-purple-400 inline-flex items-center gap-1.5 transition-colors"
                >
                  <span>LinkedIn Profile</span>
                  <span>→</span>
                </a>
              </div>
              <div>
                <a
                  href="https://prahladinala.in"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs font-semibold text-foreground hover:text-purple-400 inline-flex items-center gap-1.5 transition-colors"
                >
                  <span>Personal Portfolio</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: GOT QUESTIONS? FAQ (From Reference Image) -->
    <section class="py-16 md:py-24 border-t border-border/40">
      <div class="container mx-auto max-w-screen-xl px-4">
        <!-- FAQ Header -->
        <div class="text-center space-y-3 mb-12">
          <span class="text-purple-400 font-semibold text-xs tracking-widest uppercase block">
            GOT QUESTIONS?
          </span>
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-foreground">
            Frequently Asked Questions
          </h2>
          <p class="text-sm sm:text-base text-muted-foreground max-w-lg mx-auto leading-relaxed">
            Everything you need to know about licensing, customization, and framework compatibility.
          </p>
        </div>

        <!-- Accordion Stack -->
        <div class="max-w-2xl mx-auto space-y-3" id="faq-accordion">
          {faqs.map((faq, index) => (
            <div class="faq-item rounded-xl border border-border/80 bg-card/40 dark:bg-zinc-950/50 hover:border-zinc-700 transition-all overflow-hidden">
              <button
                type="button"
                class="faq-trigger w-full flex items-center justify-between p-4 sm:p-5 text-left font-semibold text-sm text-foreground transition-colors cursor-pointer"
                aria-expanded="false"
              >
                <span>{faq.question}</span>
                <ChevronDown class="faq-icon h-4 w-4 text-muted-foreground shrink-0 transition-transform duration-200 ml-3" />
              </button>
              <div class="faq-content hidden px-4 sm:px-5 pb-5 pt-1 text-xs sm:text-sm text-muted-foreground leading-relaxed border-t border-border/30">
                {faq.answer}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <script>
    // 1. FAQ Accordion Interactive Logic (Minimal vanilla micro-script)
    const faqItems = document.querySelectorAll('.faq-item');
    faqItems.forEach(item => {
      const trigger = item.querySelector('.faq-trigger');
      const content = item.querySelector('.faq-content');
      const icon = item.querySelector('.faq-icon');

      trigger?.addEventListener('click', () => {
        const isExpanded = trigger.getAttribute('aria-expanded') === 'true';

        // Close all items
        faqItems.forEach(other => {
          const otherTrigger = other.querySelector('.faq-trigger');
          const otherContent = other.querySelector('.faq-content');
          const otherIcon = other.querySelector('.faq-icon');

          otherTrigger?.setAttribute('aria-expanded', 'false');
          otherContent?.classList.add('hidden');
          otherIcon?.classList.remove('rotate-180');
        });

        // Toggle clicked item if it was closed
        if (!isExpanded) {
          trigger.setAttribute('aria-expanded', 'true');
          content?.classList.remove('hidden');
          icon?.classList.add('rotate-180');
        }
      });
    });

    // 2. Animated Stats Counter
    const counters = document.querySelectorAll('.stat-counter');
    const speed = 200;

    const animateCounters = () => {
      counters.forEach(counter => {
        const target = +counter.getAttribute('data-target')!;
        const count = +counter.innerText.replace('+', '');
        const inc = target / speed;

        if (count < target) {
          counter.innerText = Math.ceil(count + inc) + '+';
          setTimeout(animateCounters, 20);
        } else {
          counter.innerText = target + '+';
        }
      });
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          animateCounters();
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.5 });

    counters.forEach(counter => {
      observer.observe(counter);
    });
  </script>
</BaseLayout>
