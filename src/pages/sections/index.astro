---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const sections = await getCollection('sections');
---

<BaseLayout title="Sections | ToolMate UI">
  <div class="container mx-auto px-4 py-12 max-w-screen-xl">
    <div class="mb-8">
      <h1 class="text-4xl font-bold mb-4">Sections</h1>
      <p class="text-xl text-muted-foreground">Browse all available UI sections.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sections.map(item => (
        <a href={`/sections/${item.id}`} class="block group p-6 rounded-lg border border-border bg-card hover:border-primary transition-colors">
          <h2 class="text-xl font-semibold mb-2 group-hover:text-primary transition-colors">{item.data.title}</h2>
          <p class="text-muted-foreground">{item.data.description}</p>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
