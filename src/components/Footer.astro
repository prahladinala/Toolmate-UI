---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<footer class={`border-t border-border bg-background py-12 md:py-16 ${className}`}>
  <div class="container mx-auto max-w-screen-xl px-4 md:px-6">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4 lg:grid-cols-5">
      <div class="col-span-2 lg:col-span-2">
        <a href="/" class="font-bold text-xl flex items-center space-x-2.5 group">
          <span class="h-7 w-7 rounded-lg bg-primary text-primary-foreground flex items-center justify-center text-xs font-black shadow-sm group-hover:scale-105 transition-transform">
            T
          </span>
          <span class="tracking-tight text-foreground">ToolMate <span class="text-primary font-black">UI</span></span>
        </a>
        <p class="text-sm text-muted-foreground mt-4 max-w-xs leading-relaxed">
          Production-ready, accessible, copy-and-paste Tailwind CSS components, sections, and multi-page templates.
        </p>
        <div class="mt-4 flex items-center space-x-2 text-xs text-muted-foreground">
          <span class="inline-flex items-center px-2 py-0.5 rounded-full border border-border bg-muted/50 font-medium">
            v2.0
          </span>
          <span>• 100% Free & Open Source</span>
        </div>
      </div>
      <div>
        <h3 class="font-semibold mb-4 text-foreground text-sm uppercase tracking-wider">Catalog</h3>
        <ul class="space-y-3 text-sm text-muted-foreground">
          <li><a href="/components" class="hover:text-foreground transition-colors">UI Components</a></li>
          <li><a href="/sections" class="hover:text-foreground transition-colors">Page Sections</a></li>
          <li><a href="/templates" class="hover:text-foreground transition-colors">Landing Templates</a></li>
          <li><a href="/docs" class="hover:text-foreground transition-colors">Documentation</a></li>
        </ul>
      </div>
      <div>
        <h3 class="font-semibold mb-4 text-foreground text-sm uppercase tracking-wider">Frameworks</h3>
        <ul class="space-y-3 text-sm text-muted-foreground">
          <li><a href="/docs/nextjs" class="hover:text-foreground transition-colors">Next.js Guide</a></li>
          <li><a href="/docs/react" class="hover:text-foreground transition-colors">React Guide</a></li>
          <li><a href="/docs/astro" class="hover:text-foreground transition-colors">Astro Guide</a></li>
          <li><a href="/docs/vue" class="hover:text-foreground transition-colors">Vue Guide</a></li>
          <li><a href="/docs/angular" class="hover:text-foreground transition-colors">Angular Guide</a></li>
        </ul>
      </div>
      <div>
        <h3 class="font-semibold mb-4 text-foreground text-sm uppercase tracking-wider">Community</h3>
        <ul class="space-y-3 text-sm text-muted-foreground">
          <li><a href="https://github.com/toolmate/ui" target="_blank" rel="noreferrer" class="hover:text-foreground transition-colors">GitHub Repository</a></li>
          <li><a href="https://toolmate.co.in" target="_blank" rel="noreferrer" class="hover:text-foreground transition-colors">ToolMate Ecosystem</a></li>
          <li><a href="https://resume.toolmate.co.in" target="_blank" rel="noreferrer" class="hover:text-foreground transition-colors">ATS Resume Builder</a></li>
          <li><a href="/docs/installation" class="hover:text-foreground transition-colors">Quick Setup</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-12 border-t border-border/60 pt-8 flex flex-col md:flex-row justify-between items-center text-xs text-muted-foreground">
      <p>© {new Date().getFullYear()} ToolMate. All rights reserved. Created with ❤️ by Prahlad Inala.</p>
      <p class="mt-3 md:mt-0 flex items-center space-x-1.5">
        <span>Crafted for developers with</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" class="text-rose-500 inline-block"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
        <span>and Tailwind CSS</span>
      </p>
    </div>
  </div>
</footer>
