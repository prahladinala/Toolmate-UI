---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { Code } from 'astro:components';

interface Props {
  name: string;
  registry?: string;
}

const { name, registry = 'components' } = Astro.props;

const frameworks = [
  { id: 'html', ext: 'html', label: 'HTML', lang: 'html' },
  { id: 'react', ext: 'tsx', label: 'React', lang: 'tsx' },
  { id: 'astro', ext: 'astro', label: 'Astro', lang: 'astro' },
  { id: 'vue', ext: 'vue', label: 'Vue', lang: 'vue' },
  { id: 'svelte', ext: 'svelte', label: 'Svelte', lang: 'svelte' }
];

const codes = frameworks.map(fw => {
  try {
    const filePath = resolve(process.cwd(), `src/registry/${registry}/${name}/${fw.id}.${fw.ext}`);
    const code = readFileSync(filePath, 'utf-8');
    return { ...fw, code };
  } catch (e) {
    return { ...fw, code: null };
  }
}).filter(fw => fw.code !== null);

const htmlCode = codes.find(c => c.id === 'html')?.code || '';
---

<div class="component-preview my-6 rounded-lg border border-border bg-card text-card-foreground shadow-sm overflow-hidden" data-preview-id={name}>
  <div class="flex items-center justify-between border-b border-border px-4 bg-muted/30">
    <div class="flex space-x-2 pt-2">
      <button class="preview-tab-btn px-4 py-2 text-sm font-medium border-b-2 border-primary text-foreground" data-tab="preview">Preview</button>
      <button class="preview-tab-btn px-4 py-2 text-sm font-medium text-muted-foreground border-b-2 border-transparent hover:text-foreground" data-tab="code">Code</button>
    </div>
  </div>
  
  <div class="preview-content block p-10 flex justify-center items-center min-h-[300px] bg-grid-pattern relative" data-content="preview">
    <div class="absolute inset-0 bg-grid-slate-100 dark:bg-grid-slate-900/10 [mask-image:linear-gradient(0deg,#fff,rgba(255,255,255,0.6))] dark:[mask-image:linear-gradient(0deg,rgba(255,255,255,0.1),rgba(255,255,255,0.5))]" style="background-size: 30px 30px; background-image: radial-gradient(circle at 1px 1px, var(--color-border) 1px, transparent 0);"></div>
    <div class="relative z-10 w-full flex justify-center">
      <div set:html={htmlCode} />
    </div>
  </div>

  <div class="preview-content hidden flex-col rounded-b-lg overflow-hidden border-t border-border" data-content="code">
    {codes.length > 0 && (
      <div class="flex border-b border-border px-4 py-2 space-x-2 bg-muted/50 text-sm overflow-x-auto">
        {codes.map((fw, index) => (
          <button 
            class={`fw-btn px-3 py-1.5 rounded-md text-sm font-medium transition-colors ${index === 0 ? 'bg-background text-foreground shadow-sm' : 'text-muted-foreground hover:bg-muted hover:text-foreground'}`} 
            data-fw={fw.id}
          >
            {fw.label}
          </button>
        ))}
      </div>
    )}
    <div class="relative bg-[#0d1117] w-full">
      {codes.map((fw, index) => (
        <div class={`code-block max-h-[500px] overflow-auto [&>pre]:!bg-transparent [&>pre]:!p-4 [&>pre]:!m-0 ${index === 0 ? 'block' : 'hidden'}`} data-fw-content={fw.id}>
          <Code code={fw.code!} lang={fw.lang as any} theme="github-dark" />
        </div>
      ))}
      <button class="copy-btn absolute top-4 right-4 p-2 rounded-md bg-white/10 hover:bg-white/20 text-white/70 hover:text-white transition-colors backdrop-blur-sm" aria-label="Copy code">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
      </button>
    </div>
  </div>
</div>

<script>
  // Handle Tab Switching
  document.querySelectorAll('.component-preview').forEach(preview => {
    const tabBtns = preview.querySelectorAll('.preview-tab-btn');
    const contents = preview.querySelectorAll('.preview-content');
    
    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-tab');
        
        // Update Buttons
        tabBtns.forEach(b => {
          b.classList.remove('border-primary', 'text-foreground');
          b.classList.add('border-transparent', 'text-muted-foreground');
        });
        btn.classList.add('border-primary', 'text-foreground');
        btn.classList.remove('border-transparent', 'text-muted-foreground');
        
        // Update Content
        contents.forEach(content => {
          if (content.getAttribute('data-content') === target) {
            content.classList.remove('hidden');
            content.classList.add(target === 'code' ? 'flex' : 'block');
          } else {
            content.classList.add('hidden');
            content.classList.remove('block', 'flex');
          }
        });
      });
    });

    // Handle Framework Switching
    const fwBtns = preview.querySelectorAll('.fw-btn');
    const codeBlocks = preview.querySelectorAll('.code-block');
    
    fwBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const fw = btn.getAttribute('data-fw');
        
        // Update Buttons
        fwBtns.forEach(b => {
          b.classList.remove('bg-background', 'text-foreground', 'shadow-sm');
          b.classList.add('text-muted-foreground');
        });
        btn.classList.add('bg-background', 'text-foreground', 'shadow-sm');
        btn.classList.remove('text-muted-foreground');
        
        // Update Code Blocks
        codeBlocks.forEach(block => {
          if (block.getAttribute('data-fw-content') === fw) {
            block.classList.remove('hidden');
            block.classList.add('block');
          } else {
            block.classList.add('hidden');
            block.classList.remove('block');
          }
        });
      });
    });

    // Handle Copy
    const copyBtn = preview.querySelector('.copy-btn');
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const visibleBlock = Array.from(codeBlocks).find(b => !b.classList.contains('hidden'));
        if (visibleBlock) {
          const code = visibleBlock.textContent || '';
          navigator.clipboard.writeText(code.trim()).then(() => {
            const icon = copyBtn.innerHTML;
            copyBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 text-green-500"><polyline points="20 6 9 17 4 12"/></svg>';
            setTimeout(() => { copyBtn.innerHTML = icon; }, 2000);
          });
        }
      });
    }
  });
</script>
