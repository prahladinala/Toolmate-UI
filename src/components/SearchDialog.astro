---
---

<div id="search-dialog" class="fixed inset-0 z-50 bg-background/80 backdrop-blur-sm hidden items-start justify-center pt-[20vh]">
  <div class="relative w-full max-w-lg rounded-xl border border-border bg-card shadow-lg mx-4">
    <div class="p-4 border-b border-border flex items-center justify-between">
      <h3 class="font-semibold text-lg">Search Documentation</h3>
      <button id="close-search" class="text-muted-foreground hover:text-foreground">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>
    <div class="p-4">
      <div id="search-container"></div>
    </div>
  </div>
</div>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet">
<script is:inline src="/pagefind/pagefind-ui.js"></script>

<script is:inline>
  window.addEventListener('DOMContentLoaded', (event) => {
    new PagefindUI({ element: "#search-container", showSubResults: true });
    
    const dialog = document.getElementById('search-dialog');
    const closeBtn = document.getElementById('close-search');
    
    // Setup trigger buttons
    const triggerBtns = document.querySelectorAll('.search-trigger');
    triggerBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        dialog.classList.remove('hidden');
        dialog.classList.add('flex');
        setTimeout(() => {
          document.querySelector('.pagefind-ui__search-input')?.focus();
        }, 100);
      });
    });
    
    // Close handlers
    closeBtn.addEventListener('click', () => {
      dialog.classList.add('hidden');
      dialog.classList.remove('flex');
    });
    
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) {
        dialog.classList.add('hidden');
        dialog.classList.remove('flex');
      }
    });
    
    // Keyboard shortcut (CMD/CTRL + K)
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        dialog.classList.remove('hidden');
        dialog.classList.add('flex');
        setTimeout(() => {
          document.querySelector('.pagefind-ui__search-input')?.focus();
        }, 100);
      } else if (e.key === 'Escape' && !dialog.classList.contains('hidden')) {
        dialog.classList.add('hidden');
        dialog.classList.remove('flex');
      }
    });
  });
</script>

<style is:global>
  /* Custom Pagefind styling for dark mode compatibility */
  #search-dialog {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: #18181b;
    --pagefind-ui-text: #09090b;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: #e4e4e7;
    --pagefind-ui-tag: #f4f4f5;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0.5rem;
    --pagefind-ui-font: inherit;
  }
  
  html.dark #search-dialog {
    --pagefind-ui-primary: #fafafa !important;
    --pagefind-ui-text: #fafafa !important;
    --pagefind-ui-background: #09090b !important;
    --pagefind-ui-border: #27272a !important;
    --pagefind-ui-tag: #27272a !important;
  }
</style>
